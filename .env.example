# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Leave the two credential lines below EMPTY in this file: it is checked in, so
# anything pasted here is published and has to be rotated.
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a && . ./.env && set +a
#
# Create the credential in Sigma: Administration → APIs & Embed Secrets →
# Create New. Copy the client ID and secret at creation time; the secret is
# shown once and cannot be retrieved later.

SIGMA_CLIENT_ID=
SIGMA_CLIENT_SECRET=

# API host for your Sigma cloud and region. This cannot be guessed from the
# app URL — look the org's cloud up under Administration → Account. Getting it
# wrong looks exactly like a bad credential (HTTP 400, "Invalid access/refresh
# token"), so confirm it before troubleshooting the secret.
#   AWS-US West (most common)  https://aws-api.sigmacomputing.com
#   AWS-US East                https://api.us-a.aws.sigmacomputing.com
#   AWS-CA                     https://api.ca.aws.sigmacomputing.com
#   AWS-EU                     https://api.eu.aws.sigmacomputing.com
#   AWS-UK                     https://api.uk.aws.sigmacomputing.com
#   AWS-AU                     https://api.au.aws.sigmacomputing.com
#   Azure-US                   https://api.us.azure.sigmacomputing.com
#   Azure-EU                   https://api.eu.azure.sigmacomputing.com
#   Azure-CA                   https://api.ca.azure.sigmacomputing.com
#   Azure-UK                   https://api.uk.azure.sigmacomputing.com
#   Azure-AU                   https://api.au.azure.sigmacomputing.com
#   GCP                        https://api.sigmacomputing.com
# Source: https://help.sigmacomputing.com/reference/get-started-sigma-api
SIGMA_API_BASE_URL=https://aws-api.sigmacomputing.com

# Optional. Workspace to create the workbook in; omit to use your personal
# folder, then move it in the UI.
SIGMA_WORKSPACE_ID=
