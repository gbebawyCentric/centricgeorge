# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a && . ./.env && set +a
#
# Create the credential in Sigma: Administration → APIs & Embed Secrets →
# Create New. Copy the client ID and secret at creation time; the secret is
# shown once and cannot be retrieved later.

SIGMA_CLIENT_ID=
SIGMA_CLIENT_SECRET=

# API host for your Sigma cloud. Check the URL you use to reach Sigma:
#   AWS US (most common)  https://aws-api.sigmacomputing.com
#   AWS EU                https://api.eu-a.aws.sigmacomputing.com
#   Azure US              https://api.us-a.azure.sigmacomputing.com
#   GCP                   https://api.sigmacomputing.com
SIGMA_API_BASE_URL=https://aws-api.sigmacomputing.com

# Optional. Workspace to create the workbook in.
SIGMA_WORKSPACE_ID=

# Optional. Folder to create the workbook in — use this for a personal folder,
# which has no workspace id. Takes precedence over SIGMA_WORKSPACE_ID. Both
# apply on create only; an existing workbook is updated where it already lives.
SIGMA_FOLDER_ID=
