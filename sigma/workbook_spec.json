w=\"35 / 47\"/>\n  <Element elementId=\"tbl_top_returned\" gridColumn=\"13 / 25\" gridRow=\"35 / 47\"/>\n  <Element elementId=\"txt_footer\" gridColumn=\"1 / 25\" gridRow=\"47 / 49\"/>\n</Page>\n<Page type=\"grid\" gridTemplateColumns=\"repeat(24, 1fr)\" gridTemplateRows=\"auto\" id=\"page_data\">\n  <Element elementId=\"tbl_glance\" gridColumn=\"1 / 25\" gridRow=\"1 / 15\"/>\n  <Element elementId=\"tbl_promo_totals\" gridColumn=\"1 / 25\" gridRow=\"15 / 23\"/>\n</Page>\n"
