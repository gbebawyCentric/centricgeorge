      {
        "id": "txt_kpi_heading",
        "kind": "text",
        "body": "<p class=\"p-large\"><span style=\"color: #1B3A4B\">Ecom KPIs (plan-tracked)</span></p>"
      },
      {
        "id": "tbl_glance",
        "kind": "table",
        "source": {
          "connectionId": "82dc9446-e21c-4484-987d-79b52a490e2a",
          "kind": "warehouse-table",
          "path": [
            "SANDBOX",
            "SBX_RRAJASEKAR",
            "TB_SIGMA_QA_GLANCE_BRAND"
          ]
        },
        "columns": [
          {
            "id": "BRAND_LABEL",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/BRAND_LABEL]",
            "name": "Brand"
          },
          {
            "id": "REPORT_DATE",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/REPORT_DATE]",
            "name": "Report date"
          },
          {
            "id": "BRAND_DISPLAY_NAME",
            "formula": "Switch([TB_SIGMA_QA_GLANCE_BRAND/BRAND_ID], \"hudson-jeans\", \"Hudson Jeans\", \"favorite-daughter\", \"Favorite Daughter\", \"joes-jeans\", \"Joe's Jeans\", [TB_SIGMA_QA_GLANCE_BRAND/BRAND_LABEL])",
            "name": "Brand display name"
          },
          {
            "id": "SAME_DAY_LY_DATE",
            "formula": "DateAdd(\"day\", -364, [TB_SIGMA_QA_GLANCE_BRAND/REPORT_DATE])",
            "name": "Same day LY"
          },
          {
            "id": "YESTERDAY_DEMAND",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/YESTERDAY_DEMAND]",
            "name": "Yesterday demand $"
          },
          {
            "id": "Y_DEMAND_PLAN",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/Y_DEMAND_PLAN]",
            "name": "Yesterday plan $"
          },
          {
            "id": "SAME_DAY_LY_DEMAND",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/SAME_DAY_LY_DEMAND]",
            "name": "Same day LY $"
          },
          {
            "id": "PCT_YEST_VS_PLAN",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/PCT_YEST_VS_PLAN]",
            "name": "Yest vs plan"
          },
          {
            "id": "TREND_YEST_VS_PLAN",
            "formula": "If(IsNull([TB_SIGMA_QA_GLANCE_BRAND/PCT_YEST_VS_PLAN]), \"none\", If([TB_SIGMA_QA_GLANCE_BRAND/PCT_YEST_VS_PLAN] > 0, \"up\", If([TB_SIGMA_QA_GLANCE_BRAND/PCT_YEST_VS_PLAN] < 0, \"down\", \"flat\")))",
            "name": "Trend — yest vs plan"
          },
          {
            "id": "PCT_YEST_VS_LY",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/PCT_YEST_VS_LY]",
            "name": "Yest vs LY"
          },
          {
            "id": "TREND_YEST_VS_LY",
            "formula": "If(IsNull([TB_SIGMA_QA_GLANCE_BRAND/PCT_YEST_VS_LY]), \"none\", If([TB_SIGMA_QA_GLANCE_BRAND/PCT_YEST_VS_LY] > 0, \"up\", If([TB_SIGMA_QA_GLANCE_BRAND/PCT_YEST_VS_LY] < 0, \"down\", \"flat\")))",
            "name": "Trend — yest vs LY"
          },
          {
            "id": "MTD_DEMAND",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/MTD_DEMAND]",
            "name": "MTD demand $"
          },
          {
            "id": "LY_MTD_DEMAND",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/LY_MTD_DEMAND]",
            "name": "LY MTD $"
          },
          {
            "id": "TOTAL_MONTH_PLAN",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/TOTAL_MONTH_PLAN]",
            "name": "Month plan $"
          },
          {
            "id": "PCT_MTD_VS_PLAN",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/PCT_MTD_VS_PLAN]",
            "name": "MTD vs plan"
          },
          {
            "id": "TREND_MTD_VS_PLAN",
            "formula": "If(IsNull([TB_SIGMA_QA_GLANCE_BRAND/PCT_MTD_VS_PLAN]), \"none\", If([TB_SIGMA_QA_GLANCE_BRAND/PCT_MTD_VS_PLAN] > 0, \"up\", If([TB_SIGMA_QA_GLANCE_BRAND/PCT_MTD_VS_PLAN] < 0, \"down\", \"flat\")))",
            "name": "Trend — MTD vs plan"
          },
          {
            "id": "PCT_MTD_VS_LY",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/PCT_MTD_VS_LY]",
            "name": "MTD vs LY"
          },
          {
            "id": "TREND_MTD_VS_LY",
            "formula": "If(IsNull([TB_SIGMA_QA_GLANCE_BRAND/PCT_MTD_VS_LY]), \"none\", If([TB_SIGMA_QA_GLANCE_BRAND/PCT_MTD_VS_LY] > 0, \"up\", If([TB_SIGMA_QA_GLANCE_BRAND/PCT_MTD_VS_LY] < 0, \"down\", \"flat\")))",
            "name": "Trend — MTD vs LY"
          },
          {
            "id": "TO_GO_VS_PLAN",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/TO_GO_VS_PLAN]",
            "name": "To-go $"
          },
          {
            "id": "PCT_PLAN_ACHIEVED",
            "formula": "[TB_SIGMA_QA_GLANCE_BRAND/PCT_PLAN_ACHIEVED]",
            "name": "% plan achieved"
          }
        ],
        "name": "Ecom KPIs (plan-tracked)",
        "order": [
          "BRAND_LABEL",
          "REPORT_DATE",
          "BRAND_DISPLAY_NAME",
