      {
        "id": "tbl_promo",
        "kind": "table",
        "source": {
          "connectionId": "82dc9446-e21c-4484-987d-79b52a490e2a",
          "kind": "warehouse-table",
          "path": [
            "SANDBOX",
            "SBX_RRAJASEKAR",
            "ECOM_DAILY_PROMO"
          ]
        },
        "columns": [
          {
            "id": "BRAND_LABEL",
            "formula": "Switch([ECOM_DAILY_PROMO/BRAND_ID], \"hudson-jeans\", \"Hudson\", \"favorite-daughter\", \"FD\", \"joes-jeans\", \"Joe's\", [ECOM_DAILY_PROMO/BRAND_ID])",
            "name": "Brand",
            "hidden": true
          },
          {
            "id": "PROMO_DATE",
            "formula": "[ECOM_DAILY_PROMO/PROMO_DATE]",
            "name": "Date",
            "format": {
              "kind": "datetime",
              "formatString": "%m/%d/%Y"
            },
            "hidden": true
          },
          {
            "id": "PROMO_TEXT",
            "formula": "If(Trim(Coalesce([ECOM_DAILY_PROMO/PROMO_TEXT], \"\")) = \"\", \"— (none on Marketing Calendar for this day)\", [ECOM_DAILY_PROMO/PROMO_TEXT])",
            "name": "Promo"
          },
          {
            "id": "EMAIL_TEXT",
            "formula": "If(Trim(Coalesce([ECOM_DAILY_PROMO/EMAIL_TEXT], \"\")) = \"\", \"—\", [ECOM_DAILY_PROMO/EMAIL_TEXT])",
            "name": "Email"
          }
        ],
        "order": [
          "BRAND_LABEL",
          "PROMO_DATE",
          "PROMO_TEXT",
          "EMAIL_TEXT"
        ],
        "visibleAsSource": true,
        "name": "Scheduled promo copy"
      },
      {
        "id": "kpi_promo_amt",
        "kind": "kpi-chart",
        "source": {
          "connectionId": "82dc9446-e21c-4484-987d-79b52a490e2a",
          "kind": "sql",
          "statement": "-- Promo purchase $ — see sql/el_promo.sql for the annotated original.\n-- Shopify keeps one row per pipeline load, so de-duplicate to the latest row\n-- per order id, then join the in-scope order list to it so the promo figure\n-- inherits exactly the same scope filter as the demand numbers.\nWITH shopify_latest AS (\n    SELECT s.ID,\n           s.TOTALDISCOUNT,\n           ROW_NUMBER() OVER (PARTITION BY s.ID ORDER BY s.CREATEDAT DESC) AS rn\n    FROM SHOPIFY_APP.DEV_BRONZE.SHOPIFY_ORDERS_ADF s\n)\nSELECT o.BRAND_LABEL,\n       o.REPORT_DATE,\n       SUM(COALESCE(sl.TOTALDISCOUNT, 0))          AS PROMO_DISCOUNT_AMT,\n       COUNT_IF(COALESCE(sl.TOTALDISCOUNT, 0) > 0) AS PROMO_ORDERS\nFROM SANDBOX.SBX_RRAJASEKAR.TB_SIGMA_ORDERS_QA o\nLEFT JOIN shopify_latest sl\n       ON sl.ID = o.ORDER_ID\n      AND sl.rn = 1\nGROUP BY o.BRAND_LABEL, o.REPORT_DATE\n"
        },
        "columns": [
          {
            "id": "BRAND_LABEL",
            "formula": "[Custom SQL/BRAND_LABEL]",
            "name": "Brand",
            "hidden": true
          },
          {
            "id": "REPORT_DATE",
            "formula": "[Custom SQL/REPORT_DATE]",
            "name": "Report date",
            "format": {
              "kind": "datetime",
              "formatString": "%m/%d/%Y"
            },
            "hidden": true
          },
          {
            "id": "kpi_value",
            "formula": "Sum([Custom SQL/PROMO_DISCOUNT_AMT])",
            "name": "Promo purchase (discounts applied)",
            "format": {
              "kind": "number",
              "formatString": "$,.0f",
              "currencySymbol": "$"
            }
          }
        ],
        "value": {
          "columnId": "kpi_value"
        }
      },
      {
        "id": "kpi_promo_orders",
        "kind": "kpi-chart",
        "source": {
          "connectionId": "82dc9446-e21c-4484-987d-79b52a490e2a",
          "kind": "sql",
          "statement": "-- Promo purchase $ — see sql/el_promo.sql for the annotated original.\n-- Shopify keeps one row per pipeline load, so de-duplicate to the latest row\n-- per order id, then join the in-scope order list to it so the promo figure\n-- inherits exactly the same scope filter as the demand numbers.\nWITH shopify_latest AS (\n    SELECT s.ID,\n           s.TOTALDISCOUNT,\n           ROW_NUMBER() OVER (PARTITION BY s.ID ORDER BY s.CREATEDAT DESC) AS rn\n    FROM SHOPIFY_APP.DEV_BRONZE.SHOPIFY_ORDERS_ADF s\n)\nSELECT o.BRAND_LABEL,\n       o.REPORT_DATE,\n       SUM(COALESCE(sl.TOTALDISCOUNT, 0))          AS PROMO_DISCOUNT_AMT,\n       COUNT_IF(COALESCE(sl.TOTALDISCOUNT, 0) > 0) AS PROMO_ORDERS\nFROM SANDBOX.SBX_RRAJASEKAR.TB_SIGMA_ORDERS_QA o\nLEFT JOIN shopify_latest sl\n       ON sl.ID = o.ORDER_ID\n      AND sl.rn = 1\nGROUP BY o.BRAND_LABEL, o.REPORT_DATE\n"
        },
        "columns": [
          {
            "id": "BRAND_LABEL",
            "formula": "[Custom SQL/BRAND_LABEL]",
            "name": "Brand",
            "hidden": true
          },
          {
            "id": "REPORT_DATE",
            "formula": "[Custom SQL/REPORT_DATE]",
            "name": "Report date",
            "format": {
              "kind": "datetime",
              "formatString": "%m/%d/%Y"
            },
            "hidden": true
          },
          {
            "id": "kpi_value",
            "formula": "Sum([Custom SQL/PROMO_ORDERS])",
            "name": "Orders with a discount",
            "format": {
              "kind": "number",
              "formatString": ",d"
            }
          }
        ],
        "value": {
          "columnId": "kpi_value"
        }
      },
      {
        "id": "txt_perf_heading",
        "kind": "text",
        "body": "<p class=\"p-large\"><span style=\"color: #6A6A6A\">PERFORMANCE DETAIL — ECOM ONLY</span></p>"
      },
      {
        "id": "tbl_performance",
        "kind": "table",
        "source": {
          "connectionId": "82dc9446-e21c-4484-987d-79b52a490e2a",
          "kind": "sql",
          "statement": "-- Performance grid — see sql/el_performance_grid.sql for the annotated\n-- original. The long KPI table carries no Demand Plan metric; the email has\n-- one, assembled from the glance table's plan columns and unioned in.\nSELECT BRAND_LABEL, REPORT_DATE, METRIC_SORT, METRIC,\n       YESTERDAY, SAME_DAY_LY, MTD, LY_MTD,\n       TOTAL_MONTH_PLAN, TO_GO_VS_PLAN, PCT_PLAN_ACHIEVED\nFROM SANDBOX.SBX_RRAJASEKAR.TB_SIGMA_QA_KPI_LONG_BRAND\nUNION ALL\nSELECT BRAND_LABEL, REPORT_DATE, 1.5 AS METRIC_SORT, 'Demand Plan' AS METRIC,\n       Y_DEMAND_PLAN AS YESTERDAY, NULL AS SAME_DAY_LY, NULL AS MTD,\n       NULL AS LY_MTD, TOTAL_MONTH_PLAN, TO_GO_VS_PLAN, PCT_PLAN_ACHIEVED\nFROM SANDBOX.SBX_RRAJASEKAR.TB_SIGMA_QA_GLANCE_BRAND\n"
        },
        "columns": [
          {
            "id": "BRAND_LABEL",
            "formula": "[Custom SQL/BRAND_LABEL]",
            "name": "Brand",
            "hidden": true
          },
          {
            "id": "REPORT_DATE",
            "formula": "[Custom SQL/REPORT_DATE]",
            "name": "Report date",
            "format": {
              "kind": "datetime",
              "formatString": "%m/%d/%Y"
            },
            "hidden": true
          },
          {
            "id": "METRIC_SORT",
            "formula": "[Custom SQL/METRIC_SORT]",
            "name": "Order",
            "hidden": true
          },
          {
            "id": "METRIC",
            "formula": "[Custom SQL/METRIC]",
            "name": "Metric"
          },
          {
            "id": "YESTERDAY",
            "formula": "[Custom SQL/YESTERDAY]",
            "name": "Yesterday",
            "format": {
              "kind": "number",
              "formatString": ",.2f"
            }
          },
          {
            "id": "SAME_DAY_LY",
            "formula": "[Custom SQL/SAME_DAY_LY]",
            "name": "Same Day LY",
            "format": {
              "kind": "number",
              "formatString": ",.2f"
            }
          },
          {
            "id": "MTD",
            "formula": "[Custom SQL/MTD]",
            "name": "MTD",
            "format": {
              "kind": "number",
              "formatString": ",.2f"
            }
          },
          {
            "id": "LY_MTD",
            "formula": "[Custom SQL/LY_MTD]",
            "name": "LY MTD",
            "format": {
              "kind": "number",
              "formatString": ",.2f"
            }
          },
          {
            "id": "TOTAL_MONTH_PLAN",
            "formula": "[Custom SQL/TOTAL_MONTH_PLAN]",
            "name": "Month Plan",
            "format": {
              "kind": "number",
              "formatString": "$,.0f",
              "currencySymbol": "$"
            }
          },
          {
            "id": "TO_GO_VS_PLAN",
