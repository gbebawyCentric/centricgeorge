      {
        "id": "kpi_promo_amt",
        "kind": "kpi-chart",
        "source": {
          "connectionId": "82dc9446-e21c-4484-987d-79b52a490e2a",
          "kind": "sql",
          "statement": "WITH shopify_latest AS (\n    SELECT s.ID,\n           s.TOTALDISCOUNT,\n           ROW_NUMBER() OVER (PARTITION BY s.ID ORDER BY s.CREATEDAT DESC) AS rn\n    FROM SHOPIFY_APP.DEV_BRONZE.SHOPIFY_ORDERS_ADF s\n)\nSELECT o.BRAND_LABEL,\n       o.REPORT_DATE,\n       SUM(COALESCE(sl.TOTALDISCOUNT, 0))          AS PROMO_DISCOUNT_AMT,\n       COUNT_IF(COALESCE(sl.TOTALDISCOUNT, 0) > 0) AS PROMO_ORDERS\nFROM SANDBOX.SBX_RRAJASEKAR.TB_SIGMA_ORDERS_QA o\nLEFT JOIN shopify_latest sl\n       ON sl.ID = o.ORDER_ID\n      AND sl.rn = 1\nGROUP BY o.BRAND_LABEL, o.REPORT_DATE\n"
        },
        "columns": [
          {
            "id": "BRAND_LABEL",
            "formula": "[Custom SQL/BRAND_LABEL]",
            "name": "Brand",
            "hidden": true
          },
          {
            "id": "REPORT_DATE",
            "formula": "[Custom SQL/REPORT_DATE]",
            "name": "Report date",
            "format": {
              "kind": "datetime",
              "formatString": "%m/%d/%Y"
            },
            "hidden": true
          },
          {
            "id": "kpi_value",
            "formula": "Sum([Custom SQL/PROMO_DISCOUNT_AMT])",
            "name": "Promo purchase (discounts applied)",
            "format": {
              "kind": "number",
              "formatString": "$,.0f",
              "currencySymbol": "$"
            }
          }
        ],
        "value": {
          "columnId": "kpi_value"
        }
      },
